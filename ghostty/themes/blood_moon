# Default colors
background = #10100E
foreground = #C6C6C4

# Normal colors
palette = 0=#10100E
palette = 1=#C40233
palette = 2=#009F6B
palette = 3=#FFD700
palette = 4=#0087BD
palette = 5=#9A4EAE
palette = 6=#20B2AA
palette = 7=#C6C6C4

# Bright colors
palette = 8=#696969
palette = 9=#FF2400
palette = 10=#03C03C
palette = 11=#FDFF00
palette = 12=#007FFF
palette = 13=#FF1493
palette = 14=#00CCCC
palette = 15=#FFFAFA

# ------------------------------------------------------------------------------
# Personal preference below
# ------------------------------------------------------------------------------

# Cursor — plain foreground block, never clashes with the glyph beneath it
cursor-color = #C6C6C4
cursor-text = #10100E

# Selection — cool desaturated slate, clearly lifted off the background
selection-background = #33313A
selection-foreground = #E8E8E6

# Search (Cmd+F) — candidate matches in the palette gold, the focused match in
# the accent red so it reads as "the" hit; replaces Ghostty's yellow/peach defaults
search-background = #FFD700
search-foreground = #10100E
search-selected-background = #C40233
search-selected-foreground = #FFFAFA

# Splits — divider in the selection slate; dim unfocused panes toward the background
split-divider-color = #33313A
unfocused-split-fill = #10100E
