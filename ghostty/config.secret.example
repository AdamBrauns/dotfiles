# ------------------------------------------------------------------------------
# File: config.secret
# Info: Machine-specific Ghostty settings (window position for this monitor)
# Author: Adam Brauns (@AdamBrauns)
# ------------------------------------------------------------------------------

# Top-left corner of new windows in pixels, measured from the top-left of the
# visible screen area (below the menu bar, excluding a pinned dock). Both must
# be set or Ghostty ignores them. To center: (screen - window) / 2 per axis.
window-position-x = <X>
window-position-y = <Y>
