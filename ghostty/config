# ------------------------------------------------------------------------------
# File: config
# Info: Ghostty configuration file
# Author: Adam Brauns (@AdamBrauns)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Shell
# ------------------------------------------------------------------------------

# Run the Homebrew bash as the shell (matches alacritty's shell.program)
command = /opt/homebrew/bin/bash

# Shell integration forces a bar cursor at the prompt by default; keep the block
shell-integration-features = no-cursor

# ------------------------------------------------------------------------------
# Appearance
# ------------------------------------------------------------------------------

# Theme lives in ./themes and is found via ~/.config/ghostty/themes
theme = blood_moon

font-family = Menlo
font-size = 20

cursor-style = block
cursor-style-blink = false

# ------------------------------------------------------------------------------
# Window
# ------------------------------------------------------------------------------

window-width = 100
window-height = 35
background-opacity = 0.9

# Padding between the window edge and the terminal grid (matches alacritty's 20px)
window-padding-x = 20
window-padding-y = 20

# ------------------------------------------------------------------------------
# Input
# ------------------------------------------------------------------------------
# Treat both Option keys as Alt/Meta so readline word-motions (Alt+f/b/d) work.
macos-option-as-alt = true

# Send ESC CR on Shift+Enter (newline in readline-style prompts)
keybind = shift+enter=text:\x1b\r

# ------------------------------------------------------------------------------
# Mouse & clipboard
# ------------------------------------------------------------------------------
mouse-hide-while-typing = true
right-click-action = paste
# Selecting text also copies it to the system clipboard (alacritty save_to_clipboard)
copy-on-select = clipboard

# ------------------------------------------------------------------------------
# Bell
# ------------------------------------------------------------------------------
# Ignore the terminal bell entirely: no title emoji, no dock bounce
bell-features = no-system,no-audio,no-attention,no-title,no-border
