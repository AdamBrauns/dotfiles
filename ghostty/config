# ------------------------------------------------------------------------------
# File: config
# Info: Ghostty configuration file
# Author: Adam Brauns (@AdamBrauns)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Shell
# ------------------------------------------------------------------------------

# Run the Homebrew bash as the shell (matches alacritty's shell.program)
command = /opt/homebrew/bin/bash

# Shell integration forces a bar cursor at the prompt by default; keep the block.
# Also stop it from pushing the working directory into the window title.
# ssh-env wraps `ssh` so remote hosts get TERM=xterm-256color (plus COLORTERM)
# instead of xterm-ghostty, which they have no terminfo for.
shell-integration-features = no-cursor,no-title,ssh-env

# ------------------------------------------------------------------------------
# Appearance
# ------------------------------------------------------------------------------

# Theme lives in ./themes and is found via ~/.config/ghostty/themes
theme = blood_moon

font-family = Menlo
font-size = 20
# Thicker glyph strokes to match how alacritty renders Menlo on macOS (0-255)
font-thicken = true
font-thicken-strength = 128

# Blend text in linear space with a weight correction: removes the dark fringe
# around colored glyphs on the dark background while keeping stroke weight close
# to the macOS default. Revert to `native` if Menlo looks off.
alpha-blending = linear-corrected

cursor-style = block
cursor-style-blink = false

# Fading trail that follows the cursor between cells (see ./shaders)
custom-shader = shaders/cursor_trail.glsl
custom-shader-animation = true

# Blank title (a space, since an empty value falls back to the program name)
title = " "

# ------------------------------------------------------------------------------
# Window
# ------------------------------------------------------------------------------

window-width = 100
window-height = 35
background-opacity = 0.9
# Blur what shows through the transparent background
background-blur = true

# Native MacOS titlebar
macos-titlebar-style = native

# Hide the working-directory folder icon macOS puts in the titlebar
macos-titlebar-proxy-icon = hidden

# Padding between the window edge and the terminal grid (matches alacritty's 20px)
window-padding-x = 20
window-padding-y = 20
# Spread the leftover sub-cell pixels across all four edges instead of piling
# them on the right and bottom
window-padding-balance = true

# Save position, size, tabs, splits and each pane's cwd on every exit (not just
# forced quits) so a Sparkle relaunch or reboot brings the layout back
window-save-state = always

# Cmd+Z / Cmd+Shift+T reopens a closed tab, split or window with its shell
# intact for this long; each closed pane lingers in memory until it expires
undo-timeout = 30s

# ------------------------------------------------------------------------------
# Splits
# ------------------------------------------------------------------------------
# Moving to a neighbouring pane keeps it zoomed instead of unzooming
split-preserve-zoom = navigation

# ------------------------------------------------------------------------------
# Input
# ------------------------------------------------------------------------------
# Treat both Option keys as Alt/Meta so readline word-motions (Alt+f/b/d) work.
macos-option-as-alt = true

# Send ESC CR on Shift+Enter (newline in readline-style prompts)
keybind = shift+enter=text:\x1b\r

# ------------------------------------------------------------------------------
# Mouse & clipboard
# ------------------------------------------------------------------------------
mouse-hide-while-typing = true
right-click-action = paste
# Selecting text also copies it to the system clipboard (alacritty save_to_clipboard)
copy-on-select = clipboard

# ------------------------------------------------------------------------------
# Bell
# ------------------------------------------------------------------------------
# Ignore the terminal bell entirely: no title emoji, no dock bounce
bell-features = no-system,no-audio,no-attention,no-title,no-border

# ------------------------------------------------------------------------------
# Updates
# ------------------------------------------------------------------------------
# Let Ghostty (Sparkle) own updates: notify when a release is out, install on
# demand and relaunch cleanly. The Homebrew cask is marked auto_updates, so a
# plain `brew upgrade` skips it; never use --greedy or the two will fight.
auto-update = check
